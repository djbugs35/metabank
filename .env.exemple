# Modèle de .env : le vrai fichier est créé par outils/preparer_env.sh (ne pas remplir celui-ci à la main).
# Version de l'image Wealthfolio ; remplacer latest par un numéro (ex. 3.7.0) pour figer.
WF_VERSION=latest
# Port sur la machine hôte.
WF_PORT=8088
# 127.0.0.1 : cette machine seulement ; 0.0.0.0 : tout le réseau local (NAS).
WF_BIND=127.0.0.1
# Adresse exacte tapée dans le navigateur (obligatoire avec un mot de passe).
WF_CORS_ALLOW_ORIGINS=http://localhost:8088
# Clé de 32 octets en base64 : chiffre les secrets de data/ et signe les sessions. À garder.
WF_SECRET_KEY='<openssl rand -base64 32>'
# Empreinte Argon2id du mot de passe, entre guillemets simples (elle contient des « $ »).
WF_AUTH_PASSWORD_HASH='<argon2 ... -id -e>'
WF_REQUEST_TIMEOUT_MS=30000
